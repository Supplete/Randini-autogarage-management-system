# =============================================================================
# Randini Auto Garage - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment

# =============================================================================
# Django Core Settings
# =============================================================================
# Generate a new secret key: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# Database Configuration
# =============================================================================
DB_NAME=randinii_db
DB_USER=root
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=3306

# =============================================================================
# Email Configuration (for OTP and notifications)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Randini Garage <your-email@gmail.com>

# =============================================================================
# M-Pesa Configuration
# =============================================================================
# Update this with your actual domain for production
MPESA_CALLBACK_URL=https://yourdomain.com/mpesa-callback/

# For development, you can use ngrok:
# MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok.io/mpesa-callback/

# =============================================================================
# Security Settings (Production)
# =============================================================================
# Set to False in production
DEBUG=True

# Session settings
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# =============================================================================
# Optional: Logging Configuration
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable file logging (set to True for production)
ENABLE_FILE_LOGGING=False

# =============================================================================
# Optional: Third-party Services
# =============================================================================
# Google Analytics (optional)
GOOGLE_ANALYTICS_ID=

# Social Media Links (optional)
FACEBOOK_URL=
TWITTER_URL=
INSTAGRAM_URL=

# =============================================================================
# Development Only
# =============================================================================
# Enable debug toolbar (set to False in production)
ENABLE_DEBUG_TOOLBAR=True
