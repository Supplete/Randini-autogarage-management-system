# ════════════════════════════════════════════════════════════
# HELPER: send feedback toast to template
# ════════════════════════════════════════════════════════════
def _flash(request, level, msg):
    """Shorthand for adding a Bootstrap-styled Django message."""
    getattr(messages, level)(request, msg)


